# Cloudflare Pages headers for the failover mirror.
#
# The mirror serves the same static build as the K8s origin, but Pages does not
# run nginx.conf — so without this file the mirror answers with no CSP, no
# HSTS, and no framing protection. Since this site is served through the
# failover Worker, every request that falls back would silently lose every
# security header, exactly when the site is already having a bad day.
#
# Keep in step with nginx.conf. The two are separate files by necessity, so a
# change to the policy has to be made in both places.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
