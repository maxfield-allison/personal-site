{
  "name": "personal-site",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/shared/headers.mjs --check && node scripts/check-tracking.mjs && node scripts/copy-fonts.mjs && node scripts/gen-page-og.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fonts": "node scripts/copy-fonts.mjs",
    "headers": "node scripts/shared/headers.mjs",
    "og": "node scripts/gen-og.mjs",
    "og:pages": "node scripts/gen-page-og.mjs",
    "resume": "node scripts/gen-resume.mjs",
    "check": "astro check",
    "check:headers": "node scripts/shared/headers.mjs --check",
    "check:tracking": "node scripts/check-tracking.mjs",
    "shared:check": "node scripts/shared/sync-shared.mjs --check --source"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "typescript": "^6.0.3"
  }
}
