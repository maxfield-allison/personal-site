---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'Maxfield Allison',
  description = 'Infrastructure engineer. Multi-region enterprise Azure by day, a Kubernetes homelab by night.',
  bare = false,
  ogImage: ogImageProp,
  ogType = 'website',
} = Astro.props;

// Flat-file build makes Astro.url.pathname carry .html at build time, but nginx
// serves + everyone links the clean URL. Strip .html (and /index) so canonical
// matches the real URL and doesn't signal duplicate content.
let cleanPath = Astro.url.pathname.replace(/\.html$/, '');
if (cleanPath.endsWith('/index')) cleanPath = cleanPath.slice(0, -'index'.length);
const canonical = new URL(cleanPath || '/', Astro.site ?? 'https://maxfieldallison.com');
// Versioned so social scrapers fetch a fresh cache key. Bump on image change.
const ogImage = new URL(ogImageProp ?? '/og.png?v=1', Astro.site ?? 'https://maxfieldallison.com');

// Structured data: helps search engines and recruiter tools resolve me as a
// single entity across surfaces. Deduped by the stable @id / identity fields.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Maxfield Allison',
  url: 'https://maxfieldallison.com',
  email: 'mailto:hello@maxfieldallison.com',
  jobTitle: 'Infrastructure & Platform Engineer',
  description:
    'Infrastructure and platform engineer. Multi-region enterprise Azure by day, a production-grade Kubernetes homelab by night.',
  sameAs: [
    'https://github.com/maxfield-allison',
    'https://www.linkedin.com/in/maxfield-allison/',
    'https://bsky.app/profile/maxfieldallison.com',
    'https://probablyfine.dev',
  ],
  knowsAbout: [
    'Kubernetes',
    'GitOps',
    'Go',
    'Terraform',
    'Ansible',
    'CI/CD',
    'Linux',
    'Platform Engineering',
    'Microsoft Azure',
    'Cloud Migration',
    'Network Security',
    'Ceph',
    'Proxmox',
    'Infrastructure as Code',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Alabaster',
    addressRegion: 'AL',
    addressCountry: 'US',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <ClientRouter />
    {/* Self-hosted, privacy-friendly analytics (Umami on the homelab cluster).
        Served first-party from /pf-insights/* (CF Worker forwards to the K8s
        origin, Traefik proxies to Umami) so ad-blockers don't drop it as a
        third-party tracker domain. */}
    <script
      defer
      src="/pf-insights/script.js"
      data-website-id="ff6e58e9-5a96-4b6b-a4a3-10060bc76440"
    ></script>
  </head>
  <body class="min-h-screen flex flex-col">
    {bare ? (
      <slot />
    ) : (
      <>
        <a href="#main-content" class="skip-link">Skip to content</a>
        <Nav />
        <main id="main-content" tabindex="-1" class="flex-1">
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>

