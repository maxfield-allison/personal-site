---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// What I actually use. Kept generic and honest; no internal hostnames, IPs, or
// client detail. This is the /uses convention (uses.tech).
const groups = [
  {
    heading: 'Platform and infrastructure',
    items: [
      { name: 'GitLab', icon: 'gitlab', note: 'Where I keep the repositories, run CI, and record work in issues. It has its own VM. Linux runners handle x86-64 and ARM64 jobs; macOS and Windows runners power up when needed.' },
      { name: 'Proxmox VE', icon: 'proxmox', note: 'The five-node cluster that runs the VMs and containers underneath the lab.' },
      { name: 'Ceph', icon: 'ceph', note: 'Shared storage for the Proxmox cluster and the workloads running on it.' },
      { name: 'Kubernetes on Talos Linux', icon: 'kubernetes', note: 'Runs the applications. I manage the nodes through an API rather than logging in over SSH.' },
      { name: 'ArgoCD', icon: 'argo', note: 'Applies the Kubernetes configuration from git. I can revert a configuration change there too, then check that the application recovered.' },
      { name: 'OpenTofu', icon: 'opentofu', note: 'Defines and provisions the Proxmox VMs and LXC containers.' },
      { name: 'Ansible', icon: 'ansible', note: 'Configures the hosts and services below Kubernetes, so their setup is recorded alongside the rest of the infrastructure.' },
      { name: 'Docker', icon: 'docker', note: 'For building container images and testing services locally.' },
    ],
  },
  {
    heading: 'Networking and edge',
    items: [
      { name: 'OPNsense', icon: 'opnsense', note: 'A firewall pair with CARP failover handles routing for the lab. Needing a couple of settings that were missing from its interface led to two upstream contributions, six years apart.' },
      { name: 'Cilium', icon: 'cilium', note: 'Handles Kubernetes networking and advertises service addresses over BGP so the rest of the network can reach them.' },
      { name: 'Traefik', icon: 'traefik', note: 'Routes web requests into the cluster and handles TLS at the ingress.' },
      { name: 'Technitium DNS', note: 'The internal DNS resolvers. dnsweaver updates the service records as workloads change.' },
      { name: 'Cloudflare', icon: 'cloudflare', note: 'Public DNS and the edge in front of these sites.' },
    ],
  },
  {
    heading: 'Data and observability',
    items: [
      { name: 'PostgreSQL (Patroni)', icon: 'postgresql', note: 'Postgres with automated failover, on dedicated VMs. Keeping it outside Kubernetes means the database does not need that cluster running to start.' },
      { name: 'MariaDB and Valkey', icon: 'mariadb', note: 'For applications that need MySQL-compatible storage or a Redis-compatible service.' },
      { name: 'Prometheus and Grafana', icon: 'grafana', note: 'The metrics and dashboards I use to see what the lab is doing. Alertmanager sends the alerts.' },
      { name: 'Infisical', note: 'Stores the credentials that services need at runtime, with External Secrets supplying them to Kubernetes.' },
    ],
  },
  {
    heading: 'Languages and tooling',
    items: [
      { name: 'Bash', icon: 'bash', note: 'The glue and the scripts that run the lab, and my preference anywhere it will run. PowerShell when I have no choice, with the reference docs open.' },
      { name: 'GitHub Actions', note: 'Runs CI on the public repositories, including tests and CodeQL checks.' },
      { name: 'Renovate', icon: 'renovate', note: 'Opens updates for dependencies and container images so I can review them instead of checking versions by hand.' },
      { name: 'Linux', icon: 'linux', note: 'Debian on the development VM and Talos on the Kubernetes nodes.' },
    ],
  },
  {
    heading: 'How I work',
    items: [
      { name: 'AI-assisted engineering', note: 'I work through the design with agents and have them implement it. For scheduled jobs, I start by asking for reports and check the results before deciding whether to allow specific changes.' },
      { name: 'GitOps', note: 'I keep changes small enough to review and use git to record what the infrastructure should look like.' },
      { name: 'Runbooks and ADRs', note: "Runbooks give me somewhere to start when a problem comes back. Architecture decision records explain why I chose something, which is easy to forget after a few months." },
    ],
  },
];
---

<Layout
  title="Uses · Maxfield Allison"
  description="What I use in the lab, and what each tool does for me."
  ogImage="/og/uses.png?v=2"
>
  <section class="max-w-[var(--container-shell)] mx-auto px-6 pt-16 pb-8">
    <h1 class="font-serif text-[2.25rem] sm:text-[2.75rem] font-semibold leading-tight tracking-[-0.01em] mb-3">Uses</h1>
    <p class="text-[var(--color-ink-dim)] leading-relaxed">
      This is what I use in the lab and what each tool does for me. The <a href="https://probablyfine.dev/labs?utm_source=maxfieldallison&utm_medium=site" rel="noopener" data-umami-event="outbound-labs">lab page</a> has the hardware and a closer look at how it fits together.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="max-w-[var(--container-shell)] mx-auto px-6 py-6 border-t border-[var(--color-line)]">
        <h2 class="font-mono text-sm text-[var(--color-ink-dim)] uppercase tracking-wider mb-5">
          {group.heading}
        </h2>
        <ul class="space-y-4">
          {group.items.map((item) => (
            <li class="flex gap-3">
              <span class="mt-0.5 text-[var(--color-ink-dim)] shrink-0">
                {item.icon ? <Icon name={item.icon} size={16} /> : <span class="text-[var(--color-accent)]">·</span>}
              </span>
              <div>
                <span class="text-[var(--color-ink)]">{item.name}</span>
                <p class="text-[var(--color-ink-dim)] text-sm leading-relaxed">{item.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
