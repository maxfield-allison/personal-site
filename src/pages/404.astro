---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found · Maxfield Allison" description="That page doesn't exist.">
  <section class="max-w-[var(--container-shell)] mx-auto px-6 pt-24 pb-16">
    <p class="font-mono text-sm text-[var(--color-accent)] mb-4">404</p>
    <h1 class="font-serif text-[2.25rem] sm:text-[2.75rem] font-semibold leading-tight tracking-[-0.01em] mb-4">
      That page doesn't exist.
    </h1>
    <p class="text-[var(--color-ink-dim)] leading-relaxed mb-8">
      The link is wrong or the page moved. Nothing's on fire, probably.
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm">
      <a href="/">Home →</a>
      <a href="/projects">Work →</a>
    </div>
  </section>
</Layout>
