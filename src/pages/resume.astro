---
import Layout from '../layouts/Layout.astro';

const skills = {
  Cloud: ['Microsoft Azure', 'Azure Front Door', 'Application Gateway', 'Load Balancing', 'Cloud Migration'],
  Platform: ['Kubernetes', 'Talos Linux', 'ArgoCD', 'GitOps', 'Docker', 'Infrastructure as Code'],
  'Automation & Code': ['Go', 'Terraform / OpenTofu', 'Ansible', 'CI/CD', 'Linux'],
  Other: ['Network Security', 'Firewalls', 'Leadership', 'SQL Server'],
};

const experience = [
  {
    role: 'Senior Specialist, Technical Account Support',
    org: 'Ricoh USA, Inc.',
    dates: 'June 2024 - Present',
    bullets: [
      'Global owner of an enterprise output-management platform on Azure, serving thousands of devices across four global regions; single global escalation point.',
      'Cut platform-related support ticket volume 38% year over year by stabilizing the operating model and driving process and self-service adoption.',
      'Re-architected the platform for geo-redundancy during an enterprise MDM migration, adding global load balancing and geo-routing.',
      'Led design and buildout of a production-mirrored non-production environment on Azure.',
      'Led remediation of legacy insecure protocols (TLS 1.0/1.1, legacy LDAP); automated internal certificate renewal.',
      'Authored the platform\u2019s canonical backup and recovery runbook, now used company-wide for major-incident response.',
      'Top-tier customer survey scores with personal recognition; contributed to a five-year contract renewal.',
    ],
  },
  {
    role: 'Specialist II, Technical Account Support',
    org: 'Ricoh USA, Inc.',
    dates: 'February 2020 - June 2024',
    bullets: [
      'Implemented and managed advanced output-management solutions for education, healthcare, and multinational corporate clients.',
      'Led a security enhancement for a large healthcare institution, updating several thousand devices across multiple sites and applications to SNMP v3.',
      'Led migration of an on-premises output environment to an Azure-backed platform for a large enterprise client, consolidating dozens of Windows print servers into a fraction of the footprint on Azure VMs.',
      'Authored extensive documentation (knowledge-base articles, guides, runbooks) and served as a trusted technical consultant to client stakeholders.',
    ],
  },
  {
    role: 'Site Leader',
    org: 'Ricoh USA, Inc.',
    dates: 'August 2016 - February 2020',
    bullets: [
      'Ran a schedule of executive meetings to plan revenue, satisfaction, and cost strategy, building a team that consistently met or exceeded quarterly and annual goals.',
      'Directly supported and trained a user base of over 35,000 students, faculty, and staff.',
      'Consistently met and exceeded the one-hour service-call response SLA.',
    ],
  },
];

const projects = [
  {
    name: 'dnsweaver',
    detail:
      'Open-source Go tool that keeps DNS records in sync with your infrastructure across Technitium, Pi-hole, AdGuard, and Cloudflare. Multi-provider, split-horizon, self-hosted. Full CI/CD and semantic versioning. Author and maintainer.',
  },
  {
    name: 'Kubernetes Homelab',
    detail:
      '9-node Talos Linux cluster under ArgoCD GitOps running ~38 services; GPU sharing via time-slicing; OpenTofu and Ansible provisioning. Migrated from Docker Swarm without losing service.',
  },
  {
    name: 'maxfieldallison.com',
    detail:
      'This site: self-hosted on the Kubernetes cluster as the primary origin with a Cloudflare Pages failover mirror and an edge Worker that switches between them automatically.',
  },
];
---

<Layout title="Resume · Maxfield Allison" description="Resume of Maxfield Allison, infrastructure engineer." ogImage="/og/resume.png?v=1">
  <div class="resume max-w-[var(--container-shell)] mx-auto px-6 pt-12 pb-16">
    <div class="no-print mb-10 flex items-center justify-between">
      <a href="/" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline">← Home</a>
      <button
        onclick="window.print()"
        class="font-mono text-sm border border-[var(--color-line)] rounded px-3 py-1.5 text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] hover:border-[var(--color-accent)]/60 transition-colors"
      >
        Print
      </button>
    </div>

    {/* The cover. A rendering of the actual PDF, generated from this same page's
        print view by scripts/gen-resume.mjs, so it cannot advertise a document
        it isn't. Marked no-print so it never appears inside the PDF it depicts.
        This is the one light element on the site: it reads as a sheet of paper
        lying on the desk, an object on the page rather than page chrome. */}
    <section class="no-print grid gap-8 sm:gap-10 sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] items-start mb-14">
      <a href="/resume.pdf" data-umami-event="resume-download" class="block group no-underline hover:no-underline">
        <img
          src="/resume-cover.png"
          alt="First page of the resume PDF"
          width="816"
          height="1056"
          loading="eager"
          decoding="async"
          class="w-full h-auto border border-[var(--color-line)] shadow-lg group-hover:border-[var(--color-accent)]/60 transition-colors"
        />
      </a>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-ink-dim)] m-0">the document</p>
        <h1 class="mt-4 mb-0 font-serif text-[2rem] sm:text-[2.375rem] font-semibold leading-tight tracking-[-0.01em]">
          Maxfield Allison
        </h1>
        <p class="mt-3 mb-0 font-serif text-lg text-[var(--color-ink-dim)]">
          Infrastructure Engineer · Alabaster, Alabama
        </p>
        <p class="mt-5 mb-0 text-[0.9375rem] leading-relaxed text-[var(--color-ink-dim)] measure">
          The full resume, set as a document and kept current. Download it, print
          it, or read the whole thing below — they are the same file, generated
          from this page.
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-7 text-[0.9375rem] font-medium">
          <a
            href="/resume.pdf"
            data-umami-event="resume-download"
            class="border border-[var(--color-accent)] rounded-sm px-5 py-2.5 no-underline hover:no-underline hover:bg-[var(--color-accent)]/[0.08] transition-colors"
            >Download PDF →</a
          >
          <a href="#experience">Read it here →</a>
        </div>
        <p class="mt-6 mb-0 font-mono text-xs text-[var(--color-ink-dim)]">
          resume.pdf · US Letter · maxfieldallison.com · github.com/maxfield-allison · linkedin.com/in/maxfield-allison
        </p>
      </div>
    </section>

    {/* Print-only masthead: the cover above is screen-only, so the PDF still
        needs a name and contact block at the top. */}
    <div class="mb-6 hidden print:block">
      <h1 class="text-3xl font-semibold tracking-tight">Maxfield Allison</h1>
      <p class="text-[var(--color-ink-dim)] mt-1">Infrastructure Engineer · Alabaster, Alabama</p>
      <p class="font-mono text-sm text-[var(--color-ink-dim)] mt-2">
        maxfieldallison.com · github.com/maxfield-allison · linkedin.com/in/maxfield-allison
      </p>
    </div>

    <section class="mb-6">
      <p class="text-[var(--color-ink-dim)] leading-relaxed">
        Infrastructure engineer who owns a multi-region enterprise Azure platform
        by day and operates a production-grade Kubernetes homelab by night. I work
        fast by directing AI agents while owning the architecture, standards, and
        integration myself. Everything ships through linting, tests, and review.
      </p>
    </section>

    <section class="mb-6" id="experience">
      <h2 class="resume-h2">Experience</h2>
      {
        experience.map((job) => (
          <div class="mb-4">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-[var(--color-ink)]">{job.role}</h3>
              <span class="font-mono text-xs text-[var(--color-ink-dim)]">{job.dates}</span>
            </div>
            <p class="text-sm text-[var(--color-ink-dim)] mb-2">{job.org}</p>
            <ul class="space-y-1">
              {job.bullets.map((b) => (
                <li class="text-sm text-[var(--color-ink-dim)] leading-relaxed flex gap-2">
                  <span class="text-[var(--color-accent)]">·</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mb-6">
      <h2 class="resume-h2">Selected Projects</h2>
      {
        projects.map((p) => (
          <div class="mb-3">
            <h3 class="font-semibold text-[var(--color-ink)] text-sm">{p.name}</h3>
            <p class="text-sm text-[var(--color-ink-dim)] leading-relaxed">{p.detail}</p>
          </div>
        ))
      }
    </section>

    <section class="mb-6">
      <h2 class="resume-h2">Skills</h2>
      <div class="space-y-1.5">
        {
          Object.entries(skills).map(([group, items]) => (
            <p class="text-sm">
              <span class="font-semibold text-[var(--color-ink)]">{group}:</span>
              <span class="text-[var(--color-ink-dim)]"> {items.join(' · ')}</span>
            </p>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="resume-h2">Recognition & Certifications</h2>
      <ul class="space-y-1 text-sm text-[var(--color-ink-dim)]">
        <li class="flex gap-2"><span class="text-[var(--color-accent)]">·</span>Specialist of the Quarter (x2), Specialist of the Year, Ricoh STAR Award</li>
        <li class="flex gap-2"><span class="text-[var(--color-accent)]">·</span>Microsoft Azure Fundamentals, plus multiple enterprise product certifications</li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  /* Section heads take the document's serif voice rather than the mono/accent
     label they used to be: mono is reserved for metadata everywhere else on
     the site, and headings are where the serif does its work. This carries
     into the generated PDF, which is the same page printed. */
  .resume-h2 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.35rem;
    margin-bottom: 0.75rem;
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    .no-print {
      display: none !important;
    }
    :global(header),
    :global(footer) {
      display: none !important;
    }
    .resume :global(*) {
      color: #111 !important;
    }
    .resume-h2 {
      color: #000 !important;
      border-color: #ccc !important;
    }
  }
</style>
