---
import Layout from '../layouts/Layout.astro';

const skills = {
  Cloud: ['Microsoft Azure', 'Azure Front Door', 'Application Gateway', 'Load Balancing', 'Cloud Migration'],
  Platform: ['Kubernetes', 'Talos Linux', 'ArgoCD', 'GitLab', 'GitOps', 'Proxmox VE', 'Ceph', 'Observability (Prometheus, Grafana, Alertmanager)'],
  'Automation & Integration': ['Terraform / OpenTofu', 'Ansible', 'GitLab CI/CD', 'PowerShell', 'REST APIs & Webhooks'],
  'Architecture & Delivery': ['Solution Architecture', 'AI Agent Orchestration & Governance', 'ServiceNow (CHG / RITM / SCTASK)', 'Knowledge Management', 'Requirements & Sizing', 'Stakeholder Management', 'Customer-Facing Consulting'],
};

const experience = [
  {
    role: 'Senior Specialist, Technical Account Support',
    org: 'Ricoh USA, Inc. · Customer Engineering Services',
    dates: 'June 2024 - Present',
    pageBreak: false,
    bullets: [
      'Named application owner and single global escalation point for an enterprise output-management platform on Azure, serving thousands of devices across four global regions.',
      "Cut platform-related support ticket volume 38% year over year, measured in the customer's ServiceNow, by stabilizing the operating model and driving process and self-service adoption.",
      "Redesigning the enterprise account's operational data and documentation to support agentic systems and Microsoft Power Automate flows.",
      'Made the business case for a production-mirrored non-production environment, won the funding, and defined its design, sizing and resource requirements across three organizations, delegating provisioning to the platform teams.',
      'Identified and drove correction of configuration faults in cloud firewall and microsegmentation layers owned by other teams and vendors, including one degrading DNS for the platform globally.',
      'Contributed to the architecture decisions for the on-premises to Azure migration and the geo-redundancy re-architecture.',
      'Set the operating standard for a global support team and coached multiple specialists into primary platform roles.',
      'Identified the GPO scoping requirement in the TLS 1.0/1.1 and legacy LDAP remediation and owned the IIS and application-layer changes; automated internal certificate renewal.',
      "Authored the platform's canonical backup and recovery runbook, now used company-wide for major-incident response.",
      'Top-tier customer survey scores with personal recognition; contributed to a five-year contract renewal.',
    ],
  },
  {
    role: 'Specialist II, Technical Account Support',
    org: 'Ricoh USA, Inc.',
    dates: 'February 2020 - June 2024',
    pageBreak: false,
    bullets: [
      'Implemented and managed advanced output-management solutions for education, healthcare, and multinational corporate clients.',
      'Led a security enhancement for a large healthcare institution, updating several thousand devices across multiple sites and applications to SNMP v3.',
      'Worked alongside vendor and partner engineers on the migration of an on-premises output environment to Azure, verifying the consolidation and correcting errors during rollout.',
      'Authored extensive documentation (knowledge-base articles, guides, runbooks) and served as a trusted technical consultant to client stakeholders.',
    ],
  },
  {
    role: 'Site Leader',
    org: 'Ricoh USA, Inc.',
    dates: 'August 2016 - February 2020',
    pageBreak: true,
    bullets: [
      'Ran a schedule of executive meetings to plan revenue, satisfaction, and cost strategy, building a team that consistently met or exceeded quarterly and annual goals.',
      'Directly supported and trained a user base of over 35,000 students, faculty, and staff.',
      'Consistently met and exceeded the one-hour service-call response SLA.',
    ],
  },
];

const projects = [
  {
    name: 'dnsweaver',
    detail:
      'Open-source Go tool that synchronizes DNS records across Technitium, Pi-hole, AdGuard, and Cloudflare. A nine-stage GitLab pipeline covers tests, security, documentation, images, and releases. I own design, releases, and acceptance criteria; agents implement under review.',
  },
  {
    name: 'GitLab, GitOps & Kubernetes Homelab',
    detail:
      'Single-operator home data center on five-node Proxmox/Ceph, including nine Talos Kubernetes nodes and roughly fifty ArgoCD-managed applications. A dedicated GitLab VM is the GitOps source, registry, and operating record; Linux/x86-64, ARM64, macOS, and Windows runners handle cross-platform CI, and secret scanning gates merges. GitLab and databases stay outside Kubernetes where that boundary earns its cost. Prometheus and Alertmanager page me, backed by runbooks and post-incident records.',
  },
  {
    name: 'Multi-agent operations harness (private)',
    detail:
      'Designed concurrent AI agent operations with scoped identities, attributable GitLab records, separate read and approval-gated write paths through MCP, and graduated autonomy with least-privilege permissions. Jobs begin report-only and gain authority after verified output; I set direction, acceptance criteria, and promotion decisions.',
  },
  {
    name: 'OPNsense (upstream)',
    detail:
      'Two contributions merged upstream: traffic-shaper packet length (core, 2020) and BGP ECMP maximum-paths with documentation (FRR plugin, 2026, shipped in 1.52).',
  },
  {
    name: 'maxfieldallison.com',
    detail:
      'Portfolio and resume site with a Kubernetes-hosted primary, Cloudflare Pages failover, and edge-origin switching.',
  },
];
---

<Layout title="Resume · Maxfield Allison" description="Systems engineer and enterprise Azure platform owner, with a 9-node Kubernetes cluster under GitOps and two features merged upstream in OPNsense." ogImage="/og/resume.png?v=1">
  <div class="resume max-w-[var(--container-shell)] mx-auto px-6 pt-12 pb-16">
    <div class="no-print mb-10 flex items-center justify-between">
      <a href="/" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline">← Home</a>
      <button
        onclick="window.print()"
        data-umami-event="resume-print"
        class="font-mono text-sm border border-[var(--color-line)] rounded px-3 py-1.5 text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] hover:border-[var(--color-accent)]/60 transition-colors"
      >
        Print
      </button>
    </div>

    {/* The cover. A rendering of the actual PDF, generated from this same page's
        print view by scripts/gen-resume.mjs, so it cannot advertise a document
        it isn't. Marked no-print so it never appears inside the PDF it depicts.
        This is the one light element on the site: it reads as a sheet of paper
        lying on the desk, an object on the page rather than page chrome. */}
    <section class="no-print grid gap-8 sm:gap-10 sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] items-start mb-14">
      <a href="/resume.pdf" data-umami-event="resume-download" class="block group no-underline hover:no-underline">
        <img
          src="/resume-cover.png"
          alt="First page of the resume PDF"
          width="816"
          height="1056"
          loading="eager"
          decoding="async"
          class="arrive w-full h-auto border border-[var(--color-line)] shadow-lg group-hover:border-[var(--color-accent)]/60 transition-colors"
        />
      </a>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-ink-dim)] m-0">the document</p>
        <h1 class="mt-4 mb-0 font-serif text-[2rem] sm:text-[2.375rem] font-semibold leading-tight tracking-[-0.01em]">
          Maxfield Allison
        </h1>
        <p class="mt-3 mb-0 font-serif text-lg text-[var(--color-ink-dim)]">
          Systems Engineer · Platform Owner · Alabaster, Alabama
        </p>
        <p class="mt-5 mb-0 text-[0.9375rem] leading-relaxed text-[var(--color-ink-dim)] measure">
          The full resume, set as a document and kept current. Download it, print
          it, or read the whole thing below. They're the same file, generated
          from this page.
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-7 text-[0.9375rem] font-medium">
          <a
            href="/resume.pdf"
            data-umami-event="resume-download"
            class="border border-[var(--color-accent)] rounded-sm px-5 py-2.5 no-underline hover:no-underline hover:bg-[var(--color-accent)]/[0.08] transition-colors"
            >Download PDF →</a
          >
          <a href="#experience" data-track="resume-read-online">Read it here →</a>
        </div>
        <p class="mt-6 mb-0 font-mono text-xs text-[var(--color-ink-dim)]">
          resume.pdf · US Letter · maxfield.allison@gmail.com · maxfieldallison.com · github.com/maxfield-allison · linkedin.com/in/maxfield-allison
        </p>
      </div>
    </section>

    {/* Print-only masthead: the cover above is screen-only, so the PDF still
        needs a name and contact block at the top. Deliberately NOT an <h1> —
        the cover already supplies the page's single h1, and two would break
        the document outline for screen readers. */}
    <div class="mb-6 hidden print:block resume-masthead">
      <p class="text-3xl font-semibold tracking-tight m-0">Maxfield Allison</p>
      <p class="text-[var(--color-ink-dim)] mt-1">Systems Engineer · Platform Owner · Alabaster, Alabama</p>
      <div class="font-mono text-sm text-[var(--color-ink-dim)] mt-2 contact-line">
        <div class="contact-row">
          <span>maxfield.allison@gmail.com</span>
          <span>maxfieldallison.com</span>
        </div>
        <div class="contact-row">
          <span>github.com/maxfield-allison</span>
          <span>linkedin.com/in/maxfield-allison</span>
        </div>
      </div>
    </div>

    <section class="mb-6">
      <p class="text-[var(--color-ink-dim)] leading-relaxed">
        Systems engineer who owns a multi-region enterprise Azure platform
        by day and operates a nine-node Talos Kubernetes cluster on Proxmox and Ceph by night. Ten
        years customer-facing across enterprise accounts, now as the single global
        escalation point and named application owner. I work fast by directing AI
        agents while owning architecture, standards, and acceptance criteria.
        Agent-assisted implementation is gated by linting, tests, and review.
      </p>
    </section>

    <section class="mb-6" id="experience">
      <h2 class="resume-h2">Experience</h2>
      {
        experience.map((job) => (
          <div class:list={['mb-4', 'resume-job', { 'resume-page-two': job.pageBreak }]}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-[var(--color-ink)]">{job.role}</h3>
              <span class="font-mono text-xs text-[var(--color-ink-dim)]">{job.dates}</span>
            </div>
            <p class="text-sm text-[var(--color-ink-dim)] mb-2">{job.org}</p>
            <ul class="space-y-1 resume-list">
              {job.bullets.map((b) => (
                <li class="text-sm text-[var(--color-ink-dim)] leading-relaxed">{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mb-6">
      <h2 class="resume-h2">Selected Projects</h2>
      {
        projects.map((p) => (
          <div class="mb-3">
            <h3 class="font-semibold text-[var(--color-ink)] text-sm">{p.name}</h3>
            <p class="text-sm text-[var(--color-ink-dim)] leading-relaxed">{p.detail}</p>
          </div>
        ))
      }
    </section>

    <div class="resume-tail">
      <section class="mb-6 keep-together">
        <h2 class="resume-h2">Skills</h2>
        <div class="space-y-1.5">
          {
            Object.entries(skills).map(([group, items]) => (
              <p class="text-sm">
                <span class="font-semibold text-[var(--color-ink)]">{group}:</span>
                <span class="text-[var(--color-ink-dim)]"> {items.join(', ')}</span>
              </p>
            ))
          }
        </div>
      </section>

      <div class="resume-tail-right">
        <section class="mb-6 keep-together">
          <h2 class="resume-h2">Certifications</h2>
          <ul class="space-y-1 text-sm text-[var(--color-ink-dim)] resume-list">
            <li>Microsoft Certified: Azure Fundamentals</li>
            <li>Seven enterprise product certifications: Kofax Equitrac, AutoStore, RightFax, ControlSuite</li>
          </ul>
        </section>

        <section class="keep-together">
          <h2 class="resume-h2">Recognition</h2>
          <ul class="space-y-1 text-sm text-[var(--color-ink-dim)] resume-list">
            <li>Specialist of the Quarter (x2), Specialist of the Year, Ricoh STAR Award</li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Section heads take the document's serif voice rather than the mono/accent
     label they used to be: mono is reserved for metadata everywhere else on
     the site, and headings are where the serif does its work. This carries
     into the generated PDF, which is the same page printed. */
  .resume-h2 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .resume-list {
    list-style: disc;
    padding-inline-start: 1.15rem;
  }

  .resume-list li {
    padding-inline-start: 0.1rem;
  }

  .resume-list li::marker {
    color: var(--color-accent);
    font-size: 0.9em;
  }

  .contact-line {
    display: grid;
    gap: 0.15rem;
  }

  .contact-row {
    display: flex;
    gap: 1.5rem;
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    .no-print {
      display: none !important;
    }
    :global(header),
    :global(footer) {
      display: none !important;
    }
    .resume :global(*) {
      color: #111 !important;
    }
    .resume-h2 {
      color: #000 !important;
      border-color: #ccc !important;
      break-after: avoid;
      page-break-after: avoid;
    }
    .keep-together,
    .resume-job {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .resume-page-two {
      break-before: page;
      page-break-before: always;
    }
    .resume-tail {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 1.25rem;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* Keep a two-page document without making it read like it was squeezed
       into one. Job-aware breaks balance the pages; these values preserve
       normal reading rhythm inside each page. Screen layout is untouched. */
    .resume {
      font-size: 0.905rem;
      padding-top: 0.5rem !important;
      padding-bottom: 0 !important;
    }
    .resume-masthead {
      margin-bottom: 0.5rem !important;
    }
    .resume section {
      margin-bottom: 0.45rem !important;
    }
    .resume-h2 {
      font-size: 1.1rem;
      padding-bottom: 0.2rem;
      margin-bottom: 0.4rem;
    }
    .resume li,
    .resume section p {
      line-height: 1.22;
    }
    .resume :global(.mb-4) {
      margin-bottom: 0.5rem !important;
    }
    .resume :global(.mb-3) {
      margin-bottom: 0.35rem !important;
    }
    .resume :global(.space-y-1 > * + *) {
      margin-top: 0.1rem !important;
    }
    .resume-list li::marker {
      color: #111;
    }
  }

  /* URLs and the email are single tokens to a PDF text extractor only if the
     layout never breaks them. The LinkedIn URL used to wrap at its hyphen and
     parse as two dead fragments. */
  .contact-row span {
    white-space: nowrap;
    hyphens: none;
  }
</style>
