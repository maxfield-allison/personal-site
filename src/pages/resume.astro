---
import Layout from '../layouts/Layout.astro';

const skills = {
  Cloud: ['Microsoft Azure', 'Azure Front Door', 'Application Gateway', 'Load Balancing', 'Cloud Migration'],
  Platform: ['Kubernetes', 'Talos Linux', 'ArgoCD', 'GitLab', 'GitOps', 'Proxmox VE', 'Ceph', 'Docker'],
  'Automation & Integration': ['Terraform / OpenTofu', 'Ansible', 'GitLab CI/CD', 'PowerShell', 'REST APIs & Webhooks'],
  'Architecture & Delivery': ['Solution Architecture', 'AI Agent Orchestration & Governance', 'ServiceNow (CHG / RITM / SCTASK)', 'Knowledge Management', 'Requirements & Sizing', 'Stakeholder Management', 'Customer-Facing Consulting'],
  'Operations & Data': ['Linux', 'Prometheus / Grafana / Alertmanager', 'Network Security', 'Firewalls', 'SQL Server', 'Technical Leadership'],
};

const experience = [
  {
    role: 'Senior Specialist, Technical Account Support',
    org: 'Ricoh USA, Inc. · Customer Engineering Services',
    dates: 'June 2024 - Present',
    pageBreak: false,
    bullets: [
      'Named application owner and single global escalation point for an enterprise output-management platform on Azure, serving thousands of devices across four global regions.',
      "Cut platform support tickets 38% year over year, measured in the customer's ServiceNow, through improvements to operations, documentation and self-service.",
      "Reworking the account's operational data and documentation for use by AI agents and Microsoft Power Automate flows.",
      'Won funding for a test environment that mirrors production and defined the design, sizing and resource requirements across three organizations. Platform teams own provisioning.',
      'Found configuration faults in cloud firewalls and microsegmentation, including one breaking DNS globally, and worked with the responsible teams and vendors to get them corrected.',
      'Contributed to the architecture decisions for the on-premises to Azure migration and the geo-redundancy re-architecture.',
      'Established procedures for a global support team and coached specialists into primary platform roles.',
      'Identified which platform servers needed group-policy changes during legacy-protocol remediation. Owned the IIS and application changes and automated internal certificate renewal.',
      'Wrote the backup and recovery runbook now used company-wide during major platform incidents.',
      'Earned top-tier customer survey scores and personal recognition from the client; contributed to a five-year contract renewal.',
    ],
  },
  {
    role: 'Specialist II, Technical Account Support',
    org: 'Ricoh USA, Inc.',
    dates: 'February 2020 - June 2024',
    pageBreak: false,
    bullets: [
      'Implemented and managed output-management systems for education, healthcare, and multinational corporate clients.',
      'Led an SNMP v3 security upgrade across several thousand devices at a large healthcare institution.',
      'Worked alongside vendor and partner engineers on the migration of an on-premises output environment to Azure, verifying the consolidation and correcting errors during rollout.',
      'Wrote knowledge-base articles and runbooks, and helped client teams work through technical problems and proposed changes.',
    ],
  },
  {
    role: 'Site Leader',
    org: 'Ricoh USA, Inc.',
    dates: 'August 2016 - February 2020',
    pageBreak: true,
    bullets: [
      'Met with client leadership to plan service improvements and manage costs. Led a team that met or exceeded quarterly and annual goals.',
      'Provided support and training for a campus of over 35,000 students, faculty, and staff.',
      'Met or beat the one-hour service-call response SLA.',
    ],
  },
];

const projects = [
  {
    name: 'dnsweaver',
    detail:
      'Open-source tool that keeps DNS records in step with containers and VMs, including support for Technitium, Pi-hole, AdGuard, and Cloudflare. I own the design and releases; AI agents write the code. CI checks tests and security before release.',
  },
  {
    name: 'GitLab, GitOps & Kubernetes Homelab',
    detail:
      'Nine Talos Kubernetes nodes on a five-node Proxmox/Ceph cluster, with ArgoCD managing application configuration. GitLab runs on a separate VM, with Linux, macOS, and Windows runners. GitLab and the databases stay outside Kubernetes to avoid depending on that cluster during recovery. I run the lab with AI-assisted implementation, secret scanning in CI, and monitoring through Prometheus and Alertmanager.',
  },
  {
    name: 'AI Agent Coordination (private)',
    detail:
      'Designing a system for multiple AI agents to work on shared projects. Each has a scoped identity, work is recorded in GitLab, and separate read and write access keeps permissions explicit. Scheduled jobs start by reporting findings; I check the results before allowing specific changes.',
  },
  {
    name: 'OPNsense (upstream)',
    detail:
      'Two contributions merged upstream: traffic-shaper packet length (core, 2020) and BGP ECMP maximum-paths with documentation (FRR plugin, 2026, shipped in 1.52).',
  },
  {
    name: 'maxfieldallison.com',
    detail:
      'This site runs on my Kubernetes cluster, with a Cloudflare Pages copy available for failover.',
  },
];
---

<Layout title="Resume · Maxfield Allison" description="Ten years working with enterprise customers, now as an Azure platform owner. Experience, projects, and a downloadable resume." ogImage="/og/resume.png?v=2">
  <div class="resume max-w-[var(--container-shell)] mx-auto px-6 pt-12 pb-16">
    <div class="no-print mb-10 flex items-center justify-between">
      <a href="/" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline">← Home</a>
      <button
        onclick="window.print()"
        data-umami-event="resume-print"
        class="font-mono text-sm border border-[var(--color-line)] rounded px-3 py-1.5 text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] hover:border-[var(--color-accent)]/60 transition-colors"
      >
        Print
      </button>
    </div>

    {/* The cover. A rendering of the actual PDF, generated from this same page's
        print view by scripts/gen-resume.mjs, so it cannot advertise a document
        it isn't. Marked no-print so it never appears inside the PDF it depicts.
        This is the one light element on the site: it reads as a sheet of paper
        lying on the desk, an object on the page rather than page chrome. */}
    <section class="no-print grid gap-8 sm:gap-10 sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] items-start mb-14">
      <a href="/resume.pdf" data-umami-event="resume-download" class="block group no-underline hover:no-underline">
        <img
          src="/resume-cover.png"
          alt="First page of the resume PDF"
          width="816"
          height="1056"
          loading="eager"
          decoding="async"
          class="arrive w-full h-auto border border-[var(--color-line)] shadow-lg group-hover:border-[var(--color-accent)]/60 transition-colors"
        />
      </a>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-ink-dim)] m-0">Resume</p>
        <h1 class="mt-4 mb-0 font-serif text-[2rem] sm:text-[2.375rem] font-semibold leading-tight tracking-[-0.01em]">
          Maxfield Allison
        </h1>
        <p class="mt-3 mb-0 font-serif text-lg text-[var(--color-ink-dim)]">
          Solutions &amp; Infrastructure Architect · Platform Owner · Alabaster, Alabama
        </p>
        <p class="mt-5 mb-0 text-[0.9375rem] leading-relaxed text-[var(--color-ink-dim)] measure">
          You can read my resume below or download a copy to keep.
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-7 text-[0.9375rem] font-medium">
          <a
            href="/resume.pdf"
            data-umami-event="resume-download"
            class="border border-[var(--color-accent)] rounded-sm px-5 py-2.5 no-underline hover:no-underline hover:bg-[var(--color-accent)]/[0.08] transition-colors"
            >Download PDF →</a
          >
          <a href="#experience" data-track="resume-read-online">Read it here →</a>
        </div>
        <p class="mt-6 mb-0 font-mono text-xs text-[var(--color-ink-dim)]">
          resume.pdf · US Letter · maxfield.allison@gmail.com · maxfieldallison.com · github.com/maxfield-allison · linkedin.com/in/maxfield-allison
        </p>
      </div>
    </section>

    {/* Print-only masthead: the cover above is screen-only, so the PDF still
        needs a name and contact block at the top. Deliberately NOT an <h1> —
        the cover already supplies the page's single h1, and two would break
        the document outline for screen readers. */}
    <div class="mb-6 hidden print:block resume-masthead">
      <p class="text-3xl font-semibold tracking-tight m-0">Maxfield Allison</p>
      <p class="text-[var(--color-ink-dim)] mt-1">Solutions &amp; Infrastructure Architect · Platform Owner · Alabaster, Alabama</p>
      <div class="font-mono text-sm text-[var(--color-ink-dim)] mt-2 contact-line">
        <div class="contact-row">
          <span>maxfield.allison@gmail.com</span>
          <span>maxfieldallison.com</span>
        </div>
        <div class="contact-row">
          <span>github.com/maxfield-allison</span>
          <span>linkedin.com/in/maxfield-allison</span>
        </div>
      </div>
    </div>

    <section class="mb-6">
      <p class="text-[var(--color-ink-dim)] leading-relaxed">
        I've spent ten years working with enterprise customers, from field support to global platform ownership. Today I'm the application owner and single global escalation point for an Azure platform serving thousands of devices across four regions. I contribute to architecture decisions, make the case for improvements, and work with the teams responsible for implementing them. Outside work, I run a Kubernetes homelab and direct AI-assisted projects, including dnsweaver.
      </p>
    </section>

    <section class="mb-6" id="experience">
      <h2 class="resume-h2">Experience</h2>
      {
        experience.map((job) => (
          <div class:list={['mb-4', 'resume-job', { 'resume-page-two': job.pageBreak }]}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-[var(--color-ink)]">{job.role}</h3>
              <span class="font-mono text-xs text-[var(--color-ink-dim)]">{job.dates}</span>
            </div>
            <p class="text-sm text-[var(--color-ink-dim)] mb-2">{job.org}</p>
            <ul class="space-y-1 resume-list">
              {job.bullets.map((b) => (
                <li class="text-sm text-[var(--color-ink-dim)] leading-relaxed">{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mb-6">
      <h2 class="resume-h2">Selected Projects</h2>
      {
        projects.map((p) => (
          <div class="mb-3">
            <h3 class="font-semibold text-[var(--color-ink)] text-sm">{p.name}</h3>
            <p class="text-sm text-[var(--color-ink-dim)] leading-relaxed">{p.detail}</p>
          </div>
        ))
      }
    </section>

    <div class="resume-tail">
      <section class="mb-6 keep-together">
        <h2 class="resume-h2">Skills</h2>
        <div class="space-y-1.5">
          {
            Object.entries(skills).map(([group, items]) => (
              <p class="text-sm">
                <span class="font-semibold text-[var(--color-ink)]">{group}:</span>
                <span class="text-[var(--color-ink-dim)]"> {items.join(', ')}</span>
              </p>
            ))
          }
        </div>
      </section>

      <div class="resume-tail-right">
        <section class="mb-6 keep-together">
          <h2 class="resume-h2">Certifications</h2>
          <ul class="space-y-1 text-sm text-[var(--color-ink-dim)] resume-list">
            <li>Microsoft Certified: Azure Fundamentals</li>
            <li>Seven enterprise product certifications: Kofax Equitrac, AutoStore, RightFax, ControlSuite</li>
          </ul>
        </section>

        <section class="keep-together">
          <h2 class="resume-h2">Recognition</h2>
          <ul class="space-y-1 text-sm text-[var(--color-ink-dim)] resume-list">
            <li>Specialist of the Quarter (x2), Specialist of the Year, Ricoh STAR Award</li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Section heads take the document's serif voice rather than the mono/accent
     label they used to be: mono is reserved for metadata everywhere else on
     the site, and headings are where the serif does its work. This carries
     into the generated PDF, which is the same page printed. */
  .resume-h2 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .resume-list {
    list-style: disc;
    padding-inline-start: 1.15rem;
  }

  .resume-list li {
    padding-inline-start: 0.1rem;
  }

  .resume-list li::marker {
    color: var(--color-accent);
    font-size: 0.9em;
  }

  .contact-line {
    display: grid;
    gap: 0.15rem;
  }

  .contact-row {
    display: flex;
    gap: 1.5rem;
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    .no-print {
      display: none !important;
    }
    :global(header),
    :global(footer) {
      display: none !important;
    }
    .resume :global(*) {
      color: #111 !important;
    }
    .resume-h2 {
      color: #000 !important;
      border-color: #ccc !important;
      break-after: avoid;
      page-break-after: avoid;
    }
    .keep-together,
    .resume-job {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .resume-page-two {
      break-before: page;
      page-break-before: always;
    }
    .resume-tail {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 1.25rem;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* Keep a two-page document without making it read like it was squeezed
       into one. Job-aware breaks balance the pages; these values preserve
       normal reading rhythm inside each page. Screen layout is untouched. */
    .resume {
      font-size: 0.905rem;
      padding-top: 0.5rem !important;
      padding-bottom: 0 !important;
    }
    .resume-masthead {
      margin-bottom: 0.5rem !important;
    }
    .resume section {
      margin-bottom: 0.45rem !important;
    }
    .resume-h2 {
      font-size: 1.1rem;
      padding-bottom: 0.2rem;
      margin-bottom: 0.4rem;
    }
    .resume li,
    .resume section p {
      line-height: 1.22;
    }
    .resume :global(.mb-4) {
      margin-bottom: 0.5rem !important;
    }
    .resume :global(.mb-3) {
      margin-bottom: 0.35rem !important;
    }
    .resume :global(.space-y-1 > * + *) {
      margin-top: 0.1rem !important;
    }
    .resume-list li::marker {
      color: #111;
    }
  }

  /* URLs and the email are single tokens to a PDF text extractor only if the
     layout never breaks them. The LinkedIn URL used to wrap at its hyphen and
     parse as two dead fragments. */
  .contact-row span {
    white-space: nowrap;
    hyphens: none;
  }
</style>
