---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="min-h-screen flex items-center justify-center px-6 py-16">
    <div class="max-w-2xl w-full">
      <p class="font-mono text-sm text-[--color-ink-dim] mb-6">
        maxfieldallison.com
      </p>

      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-6">
        Maxfield Allison
      </h1>

      <p class="text-lg sm:text-xl text-[--color-ink-dim] leading-relaxed mb-4">
        Infrastructure engineer. I run multi-region enterprise Azure
        infrastructure by day and a Kubernetes homelab by night.
      </p>

      <p class="text-base text-[--color-ink-dim] leading-relaxed mb-10">
        A proper site is on the way. Until then, the work speaks for itself.
      </p>

      <div class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm mb-16">
        <a href="https://github.com/maxfield-allison" rel="me noopener">GitHub</a>
        <a href="https://www.linkedin.com/in/maxfield-allison/" rel="me noopener">LinkedIn</a>
        <a href="https://github.com/maxfield-allison/dnsweaver" rel="noopener">dnsweaver</a>
      </div>

      <div class="border-t border-[--color-line] pt-6">
        <p class="font-mono text-xs text-[--color-ink-dim]">
          Kubernetes / GitOps / Go / Azure. Built and directed, not vibe coded.
        </p>
      </div>
    </div>
  </main>
</Layout>
