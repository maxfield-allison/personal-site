---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Recent writing, pulled from the probablyfine.dev RSS feed at build time.
// Cross-origin, but fetched during the static build so it ships as HTML. A
// failed fetch (blog down at build time) just yields no section, never a broken build.
type Post = { title: string; link: string; date: Date };
let recentPosts: Post[] = [];
try {
  const res = await fetch('https://probablyfine.dev/rss.xml', {
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) {
    const xml = await res.text();
    const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].slice(0, 3);
    recentPosts = items.map((m) => {
      const block = m[1];
      const pick = (tag: string) =>
        block.match(new RegExp(`<${tag}>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</${tag}>`))?.[1]?.trim() ?? '';
      return { title: pick('title'), link: pick('link'), date: new Date(pick('pubDate')) };
    });
  }
} catch {
  recentPosts = [];
}
---

<Layout>
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-16">
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-6 leading-tight">
      I run enterprise infrastructure by day and build my own to understand it deeper.
    </h1>
    <p class="text-lg text-[var(--color-ink-dim)] leading-relaxed mb-4">
      I'm Maxfield Allison, an infrastructure engineer. My day job is a
      multi-region enterprise Azure platform. My off hours are a 9-node
      Kubernetes homelab and the open-source tools that keep it honest.
    </p>
    <p class="text-base text-[var(--color-ink-dim)] leading-relaxed mb-8">
      I work fast by directing AI agents while owning the engineering myself.
      That's AI-assisted engineering, not vibe coding. The judgment is mine;
      the typing is just faster.
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-sm">
      <a href="/about">Read more →</a>
      <a href="/projects">See the work →</a>
      <a href="https://github.com/maxfield-allison" rel="me noopener" data-umami-event="outbound-github">GitHub →</a>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6">
    <h2 class="font-mono text-sm text-[var(--color-ink-dim)] uppercase tracking-wider mb-6">
      Selected work
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="max-w-3xl mx-auto px-6 pt-12">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="font-mono text-sm text-[var(--color-ink-dim)] uppercase tracking-wider">
            Recent writing
          </h2>
          <a href="https://probablyfine.dev/blog" rel="noopener" class="font-mono text-xs">
            probablyfine.dev →
          </a>
        </div>
        <ul class="space-y-3">
          {recentPosts.map((post) => (
            <li>
              <a
                href={post.link}
                rel="noopener"
                class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 no-underline hover:no-underline"
              >
                <span class="text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
                  {post.title}
                </span>
                <time
                  datetime={post.date.toISOString().slice(0, 10)}
                  class="font-mono text-xs text-[var(--color-ink-dim)] shrink-0"
                >
                  {post.date.toISOString().slice(0, 10)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

