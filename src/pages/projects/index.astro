---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Work · Maxfield Allison" description="Projects and case studies: dnsweaver, a Kubernetes homelab, and this site." ogImage="/og/projects.png?v=1">
  <section class="max-w-3xl mx-auto px-6 pt-16">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">Work</h1>
    <p class="text-[var(--color-ink-dim)] leading-relaxed mb-10">
      Things I've built and run. Each one is real, in use, and mine to maintain.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
