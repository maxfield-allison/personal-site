---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, role, stack, links } = project.data;
const { Content } = await render(project);
---

<Layout title={`${title} · Maxfield Allison`} description={summary}>
  <article class="max-w-3xl mx-auto px-6 pt-16">
    <a href="/projects" class="font-mono text-sm text-[--color-ink-dim] no-underline hover:no-underline hover:text-[--color-ink]">
      ← Work
    </a>

    <header class="mt-6 mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">{title}</h1>
      <p class="text-lg text-[--color-ink-dim] leading-relaxed mb-5">{summary}</p>

      {role && (
        <p class="font-mono text-xs text-[--color-ink-dim] mb-4">
          Role: <span class="text-[--color-ink]">{role}</span>
        </p>
      )}

      <div class="flex flex-wrap gap-2 mb-5">
        {
          stack.map((tag) => (
            <span class="font-mono text-[11px] text-[--color-ink-dim] border border-[--color-line] rounded px-2 py-0.5">
              {tag}
            </span>
          ))
        }
      </div>

      {
        links.length > 0 && (
          <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm">
            {links.map((l) => (
              <a href={l.url} rel="noopener" data-umami-event={`outbound-${project.id}-${l.label.toLowerCase()}`}>
                {l.label} →
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose-content space-y-4 text-[--color-ink-dim] leading-relaxed border-t border-[--color-line] pt-8">
      <Content />
    </div>
  </article>

  {/* Read-completion signal: fire a Umami event once the reader scrolls near the
      end of the case study. Powers "read" goals/funnels beyond raw pageviews.
      No PII; only fires once per page, only if the analytics tracker is present. */}
  <script is:inline define:vars={{ id: project.id }}>
    (() => {
      let fired = false;
      const onScroll = () => {
        if (fired) return;
        const doc = document.documentElement;
        const reached = (window.scrollY + window.innerHeight) / doc.scrollHeight >= 0.9;
        if (!reached) return;
        fired = true;
        window.removeEventListener('scroll', onScroll);
        if (window.umami) window.umami.track('case-study-read', { id });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</Layout>

<style is:global>
  .prose-content h2 {
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
</style>
