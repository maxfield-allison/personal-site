---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { fetchStars } from '../../lib/github';
import Dinkus from '../../components/Dinkus.astro';
import ReadTracker from '../../components/ReadTracker.astro';
import Figure from '../../components/Figure.astro';
import RecordFlow from '../../components/RecordFlow.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, role, kind, stack, links, order } = project.data;
const { Content } = await render(project);

const site = Astro.site ?? 'https://maxfieldallison.com';
const pageUrl = new URL(`/projects/${project.id}`, site).href;
const repoLink = links.find((l) => /github\.com/i.test(l.url));

// Live social proof: the star count is fetched at build time and baked in.
// Shared with the home page's stat table so both quote the same fetch policy.
const stars = await fetchStars(repoLink?.url);

// Breadcrumb trail for richer search results.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${site}/projects` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

// If the project is a public repo, describe it as source code for rich results.
const softwareLd = repoLink
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: title,
      description: summary,
      codeRepository: repoLink.url,
      programmingLanguage: stack.includes('Go') ? 'Go' : stack[0],
      author: { '@type': 'Person', name: 'Maxfield Allison', url: site },
      license: 'https://opensource.org/licenses/MIT',
    }
  : null;
---

<Layout title={`${title} · Maxfield Allison`} description={summary} ogImage={`/og/${project.id}.png?v=1`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {softwareLd && <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}
  <article class="max-w-[var(--container-shell)] mx-auto px-6 pt-12 sm:pt-16 pb-8">
    <a href="/projects" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline hover:no-underline hover:text-[var(--color-ink)]">
      ← Work
    </a>

    {/* The rail carries only the folio, ghosted in --color-line so it reads as
        a printed page number rather than content. Metadata is a ruled table in
        the text column: label left, value right, hairline between rows. */}
    <div class="grid gap-6 md:gap-10 md:grid-cols-[var(--rail)_minmax(0,1fr)] mt-8">
      <aside>
        <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink-dim)]">
          case study
        </div>
        <div class="font-serif text-[2.75rem] font-semibold leading-none mt-2 text-[var(--color-line)]">
          No. {order}
        </div>
      </aside>

      <div class="min-w-0">
        <header>
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-[var(--color-ink-dim)] m-0">
            <span class="text-[var(--color-accent)]">case study no. {order}</span>{kind && <> · {kind}</>}{role && <> · {role}</>}
          </p>
          <h1 class="mt-4 mb-0 font-serif text-[2.75rem] sm:text-[3.5rem] font-semibold leading-[1.05] tracking-[-0.01em]">
            {title}
          </h1>
          <p class="mt-5 mb-0 font-serif text-lg sm:text-xl leading-[1.6] text-[var(--color-ink-dim)] max-w-[58ch]">
            {summary}
          </p>
        </header>

        {/* Specification table. The ledger head opens it, hairlines divide the
            rows, and the labels stay mono while the values take the reading
            voice — the document's way of stating facts about itself. */}
        <div class="mt-9">
          <div class="rule-double"></div>
          <dl class="grid grid-cols-[5.5rem_minmax(0,1fr)] sm:grid-cols-[10rem_minmax(0,1fr)] m-0">
            {role && (
              <>
                <dt class="py-3.5 font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">role</dt>
                <dd class="py-3.5 m-0 text-sm border-b border-[var(--color-line)]">{role}</dd>
              </>
            )}
            <dt class="py-3.5 font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">stack</dt>
            <dd class="py-3.5 m-0 font-mono text-xs text-[var(--color-ink)] border-b border-[var(--color-line)] flex flex-wrap gap-x-3 gap-y-1">
              {stack.map((tag) => <span>{tag}</span>)}
            </dd>
            {links.length > 0 && (
              <>
                <dt class="py-3.5 font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">source</dt>
                <dd class="py-3.5 m-0 font-mono text-[13px] border-b border-[var(--color-line)] flex flex-wrap gap-x-5 gap-y-1 items-baseline">
                  {links.map((l) => (
                    <a href={l.url} rel="noopener" data-umami-event={`outbound-${project.id}-${l.label.toLowerCase()}`}>
                      {l.url.replace(/^https?:\/\//, '')} →
                    </a>
                  ))}
                  {stars !== null && <span class="text-[var(--color-ink-dim)]">★ {stars.toLocaleString()}</span>}
                </dd>
              </>
            )}
          </dl>
        </div>

        {project.id === 'dnsweaver' && (
          <Figure n={1} caption="record flow: seven sources reconciled to eleven providers" class="mt-9">
            <RecordFlow />
          </Figure>
        )}

        <div class="prose-content space-y-4 text-[var(--color-ink-dim)] leading-relaxed pt-4">
          <Content />
        </div>
        <Dinkus />
      </div>
    </div>
  </article>

  <ReadTracker event="case-study-read" id={project.id} />
</Layout>

<style is:global>
  .prose-content {
    counter-reset: docsection;
  }
  /* Sections number themselves. The document numbers its own parts, and doing
     it from a counter means the markdown stays plain and the numbers can never
     fall out of order the way hand-typed ones do. */
  .prose-content h2::before {
    content: counter(docsection) '\00a0\00b7\00a0';
    counter-increment: docsection;
    color: var(--color-accent);
  }
  .prose-content h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  /* Prose stops at the measure even though the text column is wider, so the
     document keeps a readable line length. */
  .prose-content p,
  .prose-content ul,
  .prose-content ol {
    max-width: 60ch;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
</style>
