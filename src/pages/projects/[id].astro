---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, role, stack, links } = project.data;
const { Content } = await render(project);

const site = Astro.site ?? 'https://maxfieldallison.com';
const pageUrl = new URL(`/projects/${project.id}`, site).href;
const repoLink = links.find((l) => /github\.com/i.test(l.url));

// Live social proof: fetch the repo's star count at build time. Resilient, like
// the RSS pull on the home page. A failed/rate-limited fetch just yields no
// badge, never a broken build. Unauthenticated GitHub API is fine at build.
let stars: number | null = null;
if (repoLink) {
  const m = repoLink.url.match(/github\.com\/([^/]+)\/([^/#?]+)/i);
  if (m) {
    try {
      const res = await fetch(`https://api.github.com/repos/${m[1]}/${m[2].replace(/\.git$/, '')}`, {
        headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'maxfieldallison.com-build' },
        signal: AbortSignal.timeout(8000),
      });
      if (res.ok) {
        const data = await res.json();
        if (typeof data.stargazers_count === 'number') stars = data.stargazers_count;
      }
    } catch {
      stars = null;
    }
  }
}

// Breadcrumb trail for richer search results.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${site}/projects` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

// If the project is a public repo, describe it as source code for rich results.
const softwareLd = repoLink
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: title,
      description: summary,
      codeRepository: repoLink.url,
      programmingLanguage: stack.includes('Go') ? 'Go' : stack[0],
      author: { '@type': 'Person', name: 'Maxfield Allison', url: site },
      license: 'https://opensource.org/licenses/MIT',
    }
  : null;
---

<Layout title={`${title} · Maxfield Allison`} description={summary} ogImage={`/og/${project.id}.png?v=1`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {softwareLd && <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}
  <article class="max-w-3xl mx-auto px-6 pt-16">
    <a href="/projects" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline hover:no-underline hover:text-[var(--color-ink)]">
      ← Work
    </a>

    <header class="mt-6 mb-10">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">{title}</h1>
      <p class="text-lg text-[var(--color-ink-dim)] leading-relaxed mb-5">{summary}</p>

      {role && (
        <p class="font-mono text-xs text-[var(--color-ink-dim)] mb-4">
          Role: <span class="text-[var(--color-ink)]">{role}</span>
        </p>
      )}

      <div class="flex flex-wrap gap-2 mb-5">
        {
          stack.map((tag) => (
            <span class="font-mono text-[11px] text-[var(--color-ink-dim)] border border-[var(--color-line)] rounded px-2 py-0.5">
              {tag}
            </span>
          ))
        }
      </div>

      {
        links.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm">
            {links.map((l) => (
              <a href={l.url} rel="noopener" data-umami-event={`outbound-${project.id}-${l.label.toLowerCase()}`}>
                {l.label} →
              </a>
            ))}
            {stars !== null && (
              <span class="text-[var(--color-ink-dim)]">★ {stars.toLocaleString()} on GitHub</span>
            )}
          </div>
        )
      }
    </header>

    <div class="prose-content space-y-4 text-[var(--color-ink-dim)] leading-relaxed border-t border-[var(--color-line)] pt-8">
      <Content />
    </div>
  </article>

  {/* Read-completion signal: fire a Umami event once the reader scrolls near the
      end of the case study. Powers "read" goals/funnels beyond raw pageviews.
      No PII; only fires once per page, only if the analytics tracker is present.
      data-astro-rerun so it re-arms after a client-side (ClientRouter) nav. */}
  <script is:inline data-astro-rerun define:vars={{ id: project.id }}>
    (() => {
      let fired = false;
      const onScroll = () => {
        if (fired) return;
        const doc = document.documentElement;
        const reached = (window.scrollY + window.innerHeight) / doc.scrollHeight >= 0.9;
        if (!reached) return;
        fired = true;
        window.removeEventListener('scroll', onScroll);
        if (window.umami) window.umami.track('case-study-read', { id });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</Layout>

<style is:global>
  .prose-content h2 {
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
</style>
