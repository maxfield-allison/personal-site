---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { fetchStars } from '../../lib/github';
import Dinkus from '../../components/Dinkus.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, role, kind, stack, links, order } = project.data;
const { Content } = await render(project);

const site = Astro.site ?? 'https://maxfieldallison.com';
const pageUrl = new URL(`/projects/${project.id}`, site).href;
const repoLink = links.find((l) => /github\.com/i.test(l.url));

// Live social proof: the star count is fetched at build time and baked in.
// Shared with the home page's stat table so both quote the same fetch policy.
const stars = await fetchStars(repoLink?.url);

// Breadcrumb trail for richer search results.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${site}/projects` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

// If the project is a public repo, describe it as source code for rich results.
const softwareLd = repoLink
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: title,
      description: summary,
      codeRepository: repoLink.url,
      programmingLanguage: stack.includes('Go') ? 'Go' : stack[0],
      author: { '@type': 'Person', name: 'Maxfield Allison', url: site },
      license: 'https://opensource.org/licenses/MIT',
    }
  : null;
---

<Layout title={`${title} · Maxfield Allison`} description={summary} ogImage={`/og/${project.id}.png?v=1`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {softwareLd && <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}
  <article class="max-w-[var(--container-shell)] mx-auto px-6 pt-12 sm:pt-16 pb-8">
    <a href="/projects" class="font-mono text-sm text-[var(--color-ink-dim)] no-underline hover:no-underline hover:text-[var(--color-ink)]">
      ← Work
    </a>

    {/* Metadata lives in the margin rail as marginalia; the text column carries
        the document header and the prose. Below md the rail stacks above. */}
    <div class="grid gap-6 md:gap-10 md:grid-cols-[var(--rail)_minmax(0,1fr)] mt-8">
      <aside class="font-mono text-xs text-[var(--color-ink-dim)] space-y-5">
        <div class="font-serif text-2xl not-italic text-[var(--color-ink-dim)]">No. {order}</div>

        {role && (
          <div>
            <div class="uppercase tracking-[0.12em] opacity-70">Role</div>
            <div class="mt-1 text-[var(--color-ink)] leading-snug">{role}</div>
          </div>
        )}

        <div>
          <div class="uppercase tracking-[0.12em] opacity-70">Stack</div>
          <ul class="mt-1 list-none p-0 m-0 space-y-0.5 leading-snug">
            {stack.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>

        {links.length > 0 && (
          <div>
            <div class="uppercase tracking-[0.12em] opacity-70">Links</div>
            <ul class="mt-1 list-none p-0 m-0 space-y-1">
              {links.map((l) => (
                <li>
                  <a href={l.url} rel="noopener" data-umami-event={`outbound-${project.id}-${l.label.toLowerCase()}`}>
                    {l.label} →
                  </a>
                </li>
              ))}
              {stars !== null && <li class="opacity-80">★ {stars.toLocaleString()} on GitHub</li>}
            </ul>
          </div>
        )}
      </aside>

      <div class="min-w-0">
        <header>
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-[var(--color-ink-dim)] m-0">
            <span class="text-[var(--color-accent)]">case study no. {order}</span>{kind && <> · {kind}</>}
          </p>
          <h1 class="mt-4 mb-0 font-serif text-[2rem] sm:text-[2.375rem] font-semibold leading-tight tracking-[-0.01em]">
            {title}
          </h1>
          <p class="mt-5 mb-0 font-serif text-lg leading-[1.65] text-[var(--color-ink-dim)] max-w-[58ch]">
            {summary}
          </p>
          <div class="rule-double mt-7"></div>
        </header>

        <div class="prose-content space-y-4 text-[var(--color-ink-dim)] leading-relaxed pt-8">
          <Content />
        </div>
        <Dinkus />
      </div>
    </div>
  </article>

  {/* Read-completion signal: fire a Umami event once the reader scrolls near the
      end of the case study. Powers "read" goals/funnels beyond raw pageviews.
      No PII; only fires once per page, only if the analytics tracker is present.
      data-astro-rerun so it re-arms after a client-side (ClientRouter) nav. */}
  <script is:inline data-astro-rerun define:vars={{ id: project.id }}>
    (() => {
      let fired = false;
      const onScroll = () => {
        if (fired) return;
        const doc = document.documentElement;
        const reached = (window.scrollY + window.innerHeight) / doc.scrollHeight >= 0.9;
        if (!reached) return;
        fired = true;
        window.removeEventListener('scroll', onScroll);
        if (window.umami) window.umami.track('case-study-read', { id });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</Layout>

<style is:global>
  .prose-content h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  /* Prose stops at the measure even though the text column is wider, so the
     document keeps a readable line length. */
  .prose-content p,
  .prose-content ul,
  .prose-content ol {
    max-width: 60ch;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
</style>
