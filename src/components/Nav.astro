---
const pathname = Astro.url.pathname.replace(/\.html$/, '');
const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Work' },
  { href: '/uses', label: 'Uses' },
  { href: 'https://probablyfine.dev/blog?utm_source=maxfieldallison&utm_medium=site&utm_campaign=navigation', label: 'Writing', external: true },
  { href: '/resume', label: 'Resume', umami: 'nav-resume' },
];
const current = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <nav aria-label="Primary" class="page-shell site-nav">
    <a href="/" class="site-name" aria-current={pathname === '/' ? 'page' : undefined}>Maxfield Allison<span aria-hidden="true">.</span></a>
    <div class="desktop-links">
      {links.map((link) => (
        <a href={link.href} aria-current={!link.external && current(link.href) ? 'page' : undefined} data-umami-event={link.external ? 'outbound-probablyfine' : undefined} data-track={link.umami}>{link.label}</a>
      ))}
    </div>
    <details class="mobile-nav">
      <summary data-umami-event="nav-menu">Menu</summary>
      <div class="mobile-links">
        {links.map((link) => (
          <a href={link.href} aria-current={!link.external && current(link.href) ? 'page' : undefined} data-umami-event={link.external ? 'outbound-probablyfine' : undefined} data-track={link.umami}>{link.label}</a>
        ))}
      </div>
    </details>
  </nav>
</header>
