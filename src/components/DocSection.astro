---
// A numbered section of the document: a label in the margin rail, content in
// the text column. The rail is a true margin column — section labels, folios,
// and dates live there and prose never enters it. Below md the rail collapses
// and the label sits above the content, which keeps the mobile reading column
// full width instead of squeezing it against an empty gutter.
interface Props {
  /** Rail label, e.g. "section 1". Rendered mono, uppercase, letterspaced. */
  label?: string;
  /** Element for the label. Defaults to a div, because on most pages the rail
      carries an ordinal ("section 1") rather than a heading. Pass 'h2' where
      the label genuinely names the section — otherwise the page's h1 is
      followed directly by the h3s inside, which skips a level. */
  labelAs?: 'div' | 'h2';
  /** Vertical rhythm. Sections breathe; this site's posture is air. */
  spacing?: 'normal' | 'tight';
  class?: string;
}

const { label, labelAs: LabelTag = 'div', spacing = 'normal', class: className } = Astro.props;
const pad = spacing === 'tight' ? 'py-12' : 'py-16 sm:py-24';
---

<section class:list={['max-w-[var(--container-shell)] mx-auto px-6', className]}>
  <div class:list={['grid gap-4 md:gap-10 md:grid-cols-[var(--rail)_minmax(0,1fr)]', pad]}>
    <LabelTag class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--color-ink-dim)] md:pt-1.5 m-0 font-normal">
      {label}
    </LabelTag>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
