---
// fig. 1 — what dnsweaver actually does, in one line of reading.
//
// Hand-authored markup rather than an image: it costs nothing to ship, stays
// crisp at any zoom, re-flows on a phone, and the text inside it is real text
// that search engines and screen readers can read. Same hairline vocabulary as
// the sibling site's topology diagram, kept in the explanatory tense.
//
// The numbers are deliberately the ones on the case study and in PROFILE: seven
// sources, eleven providers. If those change, they change in both places.
// Three lines each, as the design sets them: enough to show the breadth
// without turning the plate into a feature list.
interface Props { interactive?: boolean; }
const { interactive = false } = Astro.props;
const sources = ['traefik · caddy · nginx-proxy', 'native labels · kubernetes', 'proxmox ve · incus'];
const middle = ['reconcile records', 'track ownership', 'create · update · clean up'];
const providers = ['cloudflare · technitium', 'pi-hole · and eight more', 'per-provider zones'];
---

<record-flow>

<div
  class="flow-figure grid gap-2 items-stretch grid-cols-1 sm:grid-cols-[minmax(0,1fr)_2.5rem_minmax(0,1fr)_2.5rem_minmax(0,1fr)]"
  role="img"
  aria-label="Record flow: seven sources are reconciled by dnsweaver and written to eleven DNS providers"
>
  <div data-flow-layer class="border border-[var(--color-line)] px-4.5 py-4">
    <div class="font-mono text-[13px] text-[var(--color-ink)]">7 sources</div>
    <div class="font-mono text-[0.6875rem] text-[var(--color-ink-dim)] mt-2 leading-[1.7]">
      {sources.map((l) => <div>{l}</div>)}
    </div>
  </div>

  <div class="hidden sm:flex items-center" aria-hidden="true"><div class="w-full h-px bg-[var(--color-line)]"></div></div>

  <div data-flow-layer class="border border-[var(--color-accent)] px-4.5 py-4">
    <div class="font-mono text-[13px] text-[var(--color-accent)]">dnsweaver</div>
    <div class="font-mono text-[0.6875rem] text-[var(--color-ink-dim)] mt-2 leading-[1.7]">
      {middle.map((l) => <div>{l}</div>)}
    </div>
  </div>

  <div class="hidden sm:flex items-center" aria-hidden="true"><div class="w-full h-px bg-[var(--color-line)]"></div></div>

  <div data-flow-layer class="border border-[var(--color-line)] px-4.5 py-4">
    <div class="font-mono text-[13px] text-[var(--color-ink)]">11 providers</div>
    <div class="font-mono text-[0.6875rem] text-[var(--color-ink-dim)] mt-2 leading-[1.7]">
      {providers.map((l) => <div>{l}</div>)}
    </div>
  </div>
</div>

{interactive && <details class="flow-explanation">
  <summary>Open the mechanism</summary>
  <p>A source reports a service. dnsweaver reconciles the record and its ownership, then writes to the provider. This example runs only here on the page.</p>
  <button type="button" data-service-toggle disabled aria-pressed="false">Add an example service</button>
  <div class="flow-records"><p><code>app.example.test</code> <span data-owned-record>No managed record</span></p><p><code>mail.example.test</code> <span>Manual record · unchanged</span></p></div>
  <p data-flow-status role="status">Remove the example service to see which record is cleaned up.</p>
</details>}
</record-flow>
<script>
  class RecordFlow extends HTMLElement {
    private controller?: AbortController;
    private effects: Animation[] = [];
    connectedCallback() {
      this.controller?.abort(); this.controller = new AbortController();
      const button = this.querySelector<HTMLButtonElement>('[data-service-toggle]');
      if (!button) return; button.disabled = false;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const stop = () => { this.effects.forEach(effect => effect.cancel()); this.effects = []; };
      button.addEventListener('click', () => {
        stop(); const added = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(added)); button.textContent = added ? 'Remove the example service' : 'Add an example service';
        this.querySelector('[data-owned-record]')!.textContent = added ? '192.0.2.20 · managed by dnsweaver' : 'No managed record';
        this.querySelector('[data-flow-status]')!.textContent = added ? 'The managed record was created. The manual record stayed unchanged.' : 'The managed record was removed. The manual record stayed unchanged.';
        if (motion.matches || document.documentElement.classList.contains('response-still')) return;
        this.querySelectorAll('[data-flow-layer]').forEach((layer, index) => {
          this.effects.push(layer.animate([{boxShadow:'0 0 0 0 transparent'},{boxShadow:'0 0 0 2px var(--color-accent)'},{boxShadow:'0 0 0 0 transparent'}], {duration:600, delay:index*130}));
        });
      }, {signal:this.controller.signal});
      motion.addEventListener('change', stop, {signal:this.controller.signal});
      document.addEventListener('visibilitychange', stop, {signal:this.controller.signal});
      document.addEventListener('response:still', stop, {signal:this.controller.signal});
      window.addEventListener('pagehide', stop, {signal:this.controller.signal});
    }
    disconnectedCallback() { this.controller?.abort(); this.effects.forEach(effect => effect.cancel()); this.effects = []; }
  }
  if (!customElements.get('record-flow')) customElements.define('record-flow', RecordFlow);
</script>
<style>
  record-flow{display:block}.flow-figure{perspective:1000px;padding-block:4px;transition:padding .4s}.flow-figure [data-flow-layer]{background:var(--color-base);transition:transform .4s,box-shadow .4s}record-flow:has(details[open]) .flow-figure{padding-block:24px}record-flow:has(details[open]) [data-flow-layer]{transform:rotateY(-8deg) translateZ(20px);box-shadow:5px 8px 0 color-mix(in srgb,var(--color-accent) 8%,transparent)}.flow-explanation{border-top:1px solid var(--color-line);margin-top:18px;padding-top:12px;font-size:.875rem;line-height:1.7}.flow-explanation summary{cursor:pointer;color:var(--color-accent);min-height:44px}.flow-explanation button{border:1px solid var(--color-line);padding:8px 12px;min-height:44px;border-radius:4px;cursor:pointer}.flow-records{border-block:1px solid var(--color-line);margin-top:16px}.flow-records p{display:flex;gap:12px;flex-wrap:wrap}.flow-records code{overflow-wrap:anywhere}@media(max-width:640px),(prefers-reduced-motion:reduce){record-flow:has(details[open]) [data-flow-layer]{transform:none;box-shadow:none}.flow-figure,.flow-figure [data-flow-layer]{transition:none}}
</style>
