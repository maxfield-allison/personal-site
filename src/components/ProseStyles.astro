---
// The document's prose styling, shared by every long-form page so the two
// routes cannot drift apart. Case studies and field notes render the same
// markdown shapes and must look identical doing it.
//
// Wrap rendered content in `.prose-content` and include this component once
// on the page.
---

<style is:global>
  .prose-content {
    counter-reset: docsection;
  }
  /* Sections number themselves. The document numbers its own parts, and doing
     it from a counter means the markdown stays plain and the numbers can never
     fall out of order the way hand-typed ones do. */
  .prose-content h2::before {
    content: counter(docsection) '\00a0\00b7\00a0';
    counter-increment: docsection;
    color: var(--color-accent);
  }
  .prose-content h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  /* Prose stops at the measure even though the text column is wider, so the
     document keeps a readable line length. */
  .prose-content p,
  .prose-content ul,
  .prose-content ol {
    max-width: 60ch;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
</style>
