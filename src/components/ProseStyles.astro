---
// The document's prose styling, shared by every long-form page so the two
// routes cannot drift apart. Case studies and field notes render the same
// markdown shapes and must look identical doing it.
//
// Wrap rendered content in `.prose-content` and include this component once
// on the page.
---

<style is:global>
  .article-reader {
    max-width: 42rem;
    margin-top: 2rem;
  }
  .prose-content {
    color: var(--color-ink-dim);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-content > :first-child {
    margin-top: 0;
  }
  .prose-content h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 2.5rem 0 1rem;
  }
  .prose-content h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 1.75rem 0 0.75rem;
  }
  .prose-content p,
  .prose-content ul,
  .prose-content ol {
    margin: 0 0 1.25rem;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-content li {
    margin-bottom: 0.35rem;
  }
  .prose-content strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
  .prose-content figure {
    margin: 2rem 0;
  }
  .prose-content figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
  }
  .prose-content figcaption {
    margin-top: 0.75rem;
    color: var(--color-ink-dim);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose-content .placement-example {
    border-block: 1px solid var(--color-line);
    padding-block: 1.5rem;
  }
  .prose-content .placement-example__title {
    color: var(--color-ink);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .prose-content .placement-options {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .prose-content .placement-options li {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 1rem;
    margin: 0;
  }
  .placement-options strong,
  .placement-options span {
    display: block;
  }
  .placement-options strong {
    font-size: 1rem;
  }
  .placement-options span {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    .prose-content .placement-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
