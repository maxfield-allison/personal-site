---
// Shape kept deliberately identical to probablyfine-site/src/components/Footer.astro:
// the identity link row and the cross-site network strip are the verbatim layer
// shared by both sites. Only the tagline, the trailing site-specific link
// (Source here, RSS there), and which domain carries the accent differ.
// Edit both together.
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] mt-24">
  <div
    class="max-w-[var(--container-shell)] mx-auto px-6 py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-mono text-xs text-[var(--color-ink-dim)]"
  >
    <p>© {year} Maxfield Allison</p>
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="mailto:hello@maxfieldallison.com" rel="me" data-umami-event="email-click" class="inline-flex items-center gap-1.5">
        <Icon name="email" size={14} /> Email
      </a>
      <a href="https://github.com/maxfield-allison" rel="me noopener" data-umami-event="outbound-github" class="inline-flex items-center gap-1.5">
        <Icon name="github" size={14} /> GitHub
      </a>
      <a href="https://www.linkedin.com/in/maxfield-allison/" rel="me noopener" data-umami-event="outbound-linkedin" class="inline-flex items-center gap-1.5">
        <Icon name="linkedin" size={14} /> LinkedIn
      </a>
      <a href="https://bsky.app/profile/maxfieldallison.com" rel="me noopener" data-umami-event="outbound-bluesky" class="inline-flex items-center gap-1.5">
        <Icon name="bluesky" size={14} /> Bluesky
      </a>
      <a href="https://www.facebook.com/maxfield.allison" rel="me noopener" data-umami-event="outbound-facebook" class="inline-flex items-center gap-1.5">
        <Icon name="facebook" size={14} /> Facebook
      </a>
      <a href="https://github.com/maxfield-allison/personal-site" rel="noopener" data-umami-event="outbound-source" class="inline-flex items-center gap-1.5">
        <Icon name="github" size={14} /> Source
      </a>
    </div>
  </div>
  <div class="max-w-[var(--container-shell)] mx-auto px-6 pb-10 space-y-2">
    <p class="font-mono text-[11px] text-[var(--color-ink-dim)]/70">
      <span class="text-[var(--color-accent)]">maxfieldallison.com</span>
      <span class="text-[var(--color-ink-dim)]/50"> · </span>
      <a href="https://probablyfine.dev?utm_source=maxfieldallison&utm_medium=site" rel="noopener" data-umami-event="outbound-probablyfine" class="hover:text-[var(--color-ink)]">probablyfine.dev</a>
      <span class="text-[var(--color-ink-dim)]/50">. Two sites, one person.</span>
    </p>
    <p class="font-mono text-[11px] text-[var(--color-ink-dim)]/70">
      Self-hosted on a personal Kubernetes cluster with a Cloudflare Pages
      failover mirror. Built and directed, not vibe coded.
    </p>
  </div>
</footer>
